# ─── API ─────────────────────────────────────────────────
# Backend API base URL (no trailing slash).
# Dev:        http://localhost:5010/api
# Production: https://your-api-domain.com/api
VITE_API_URL=http://localhost:5010/api

# ─── Store ───────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173

# WhatsApp number shown in footer fallback + used for message links.
# Digits only, international format without '+' (e.g. 923001234567).
# The live number is managed from the Admin → Settings panel.
VITE_WHATSAPP_NUMBER=923001234567